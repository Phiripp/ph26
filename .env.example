# Copy to .env and fill in what you need (.env is git-ignored). Every value here is a placeholder.
# Copiar a .env y completar lo que haga falta (.env no se sube a git).
#
# Nothing below is needed to open the page or to run the API on the data already in the repo.
# The scripts in scripts/extract/ read DMC_* from .env; the API and the shell scripts read the
# process environment (export the variable or prefix the command).

# --- Data pipeline (scripts/extract/) --------------------------------------------------------
# DMC (Dirección Meteorológica de Chile) station API: free account at https://climatologia.meteochile.gob.cl
DMC_USER=
DMC_TOKEN=
# ERA5-Land through the Copernicus Climate Data Store (national run only). In GCP it lives in Secret Manager.
CDS_API_KEY=

# --- API (api/) ---------------------------------------------------------------------------------
# Extra origins allowed by CORS, comma separated. localhost is always allowed; nothing else is by default.
# CAUDAL_ORIGENES=https://your-frontend.example
# Folder for newly generated complaint files (default: data/processed/expedientes).
# CAUDAL_EXPEDIENTES=/tmp/expedientes
# Time limit in seconds for one PDF generation (default 180).
# CAUDAL_TOPE_S=180
# Repo or image root (default: the folder that contains api/).
# CAUDAL_RAIZ=
# Exploratory national run: folder with one region=RXX/puntaje.parquet per region. Unset = /api/chile answers 503.
# CAUDAL_NACIONAL=/path/to/modelo/chile-2025-26
# CAUDAL_NACIONAL_TTL=300

# --- Pipeline working folders (scripts/comun/rutas.py) ------------------------------------------
# CAUDAL_DATA=        # data/ folder to read and write (default: the repo's)
# CAUDAL_ZONAS=       # zones file (default: data/zonas.json)

# --- GCP helper scripts (scripts/cloud/, scripts/gcp/, infra/) ----------------------------------
# PROYECTO=your-gcp-project
# CUENTA=you@example.com      # default: the active gcloud account
# BUCKET=your-bucket
